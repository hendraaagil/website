---
import { Image, getImage } from 'astro:assets'
import { getCollection, render } from 'astro:content'
import RootLayout from '@/layouts/root-layout.astro'
import PostComment from '@/components/post-comment'
import ScrollProgress from '@/components/scroll-progress'

import { mdxComponents } from '@/components/mdx'
import { formatDate, getReadingTime } from '@/lib/utils'
import Badge from '@/components/badge'
import { ChevronRight } from 'lucide-react'

export async function getStaticPaths() {
	const posts = await getCollection('post')
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}))
}

const { post } = Astro.props
const {
	language,
	title,
	thumbnail: thumbnailOrigin,
	thumbnailCredit,
	summary,
	tags,
	author,
	createdAt,
	updatedAt,
} = post.data
const { Content, headings } = await render(post)
const toc = headings.filter(
	(heading) => heading.depth === 2 || heading.depth === 3,
)

const readingTime = getReadingTime(post.body ?? '')
const formattedDate = formatDate(createdAt, 'long')
const thumbnail = await getImage({
	src: thumbnailOrigin,
	format: 'webp',
	width: thumbnailOrigin.width,
	height: thumbnailOrigin.height,
})
---

<RootLayout
	metadata={{
		title: title,
		description: summary,
		article: {
			author: author,
			publishedTime: createdAt.toISOString(),
			modifiedTime: updatedAt.toISOString(),
			tags: tags,
			language: language,
		},
	}}
>
	<Fragment slot="head">
		<link rel="preload" href={thumbnail.src} as="image" />
	</Fragment>

	<article>
		<figure class="overflow-hidden bg-muted text-center">
			<Image
				width={thumbnailOrigin.width}
				height={thumbnailOrigin.height}
				src={thumbnail.src}
				alt={`Thumbnail for article ${title}`}
				class="w-full"
				transition:name={`post-thumbnail-${post.id}`}
				loading="eager"
				fetchpriority="high"
				priority
			/>
			{thumbnailCredit && (
				<figcaption class="py-2 text-xs text-muted-foreground">
					{thumbnailCredit}
				</figcaption>
			)}
		</figure>

		<div class="space-y-3 p-3 sm:p-6">
			<div class="flex items-center text-sm font-medium text-muted-foreground sm:text-base [&_span]:text-[length:inherit]">
				<span class="flex items-center gap-2">
					<span>Published at</span>
					<time datetime={createdAt.toISOString()}>{formattedDate}</time>
				</span>
				<span class="mx-1.5">・</span>
				<span>{readingTime} minute(s) read</span>
			</div>

			<h1 transition:name={`post-title-${post.id}`}>{title}</h1>
			<p
				class="text-muted-foreground"
				transition:name={`post-description-${post.id}`}
			>
				{summary}
			</p>

			<div class="flex items-center gap-2">
				{tags.map((tag) => (
					<Badge>{tag}</Badge>
				))}
			</div>
		</div>

		<hr class="border-border" />

		{toc.length > 0 && (
			<details class="group border-b">
				<summary class="flex cursor-pointer list-none items-center gap-2 px-3 py-2 text-base font-medium text-muted-foreground transition-colors hover:text-foreground sm:px-6 sm:py-3 sm:text-lg [&::-webkit-details-marker]:hidden">
					<ChevronRight className="size-4 shrink-0 transition-transform group-open:rotate-90" />
					Table of contents
				</summary>
				<ol class="space-y-1 pr-3 pb-3 pl-9 sm:pr-6 sm:pb-6 sm:pl-12">
					{toc.map((heading) => (
						<li class:list={[heading.depth === 3 && 'pl-4']}>
							<a href={`#${heading.slug}`} class="underline hover:text-primary">
								{heading.text}
							</a>
						</li>
					))}
				</ol>
			</details>
		)}

		<section id="post-content" class="p-3 sm:p-6">
			<Content components={mdxComponents} />
		</section>

		<hr class="border-border" />

		<section class="p-3 sm:p-6">
			<PostComment client:load />
		</section>
	</article>

	<ScrollProgress targetId="post-content" client:idle />
</RootLayout>
